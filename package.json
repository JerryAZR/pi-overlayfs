{
	"name": "pi-overlayfs",
	"version": "0.1.0",
	"description": "Route pi's file-touching tools through a copy-on-write overlay filesystem with a per-tool-call apply/approve finisher",
	"type": "module",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"main": "./dist/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@jerryan/just-bash": "^3.7.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-server": "^0.85.0",
		"@types/node": "^22.0.0",
		"typebox": "*",
		"typescript": "^5.6.0",
		"vitest": "^3.0.0"
	}
}
